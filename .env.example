# .env.example (updated)

# =============================
# LLM Model Configuration
# =============================

# Default model used for all agents unless overridden below
# Format: provider/model_name
# Providers supported: anthropic, openai, azure-foundry, ollama, vllm
DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# Per-agent model overrides (optional)
# NARRATOR_MODEL=anthropic/claude-sonnet-4-20250514
# ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-20250514
# COORDINATOR_MODEL=anthropic/claude-sonnet-4-20250514
# CLINICIAN_MODEL=anthropic/claude-sonnet-4-20250514
# SCRIBE_MODEL=anthropic/claude-sonnet-4-20250514
# CONSTRUCTOR_MODEL=anthropic/claude-sonnet-4-20250514
# INVESTIGATOR_MODEL=anthropic/claude-sonnet-4-20250514


# =============================
# API Keys
# =============================

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Azure OpenAI / Azure Foundry OpenAI-compatible
# (used when model prefix is azure-foundry/...)
# AZURE_OPENAI_API_KEY=...


# =============================
# OpenAI-Compatible Endpoints
# =============================

# Ollama (OpenAI-compatible)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# vLLM (OpenAI-compatible)
# VLLM_BASE_URL=http://localhost:8000/v1

# Azure OpenAI / Foundry OpenAI-compatible endpoint
# Set either BASE_URL or RESOURCE_NAME:

# Option A: explicit base URL
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1

# Option B: resource name only (base URL auto-built)
# AZURE_OPENAI_RESOURCE_NAME=<resource>

# Whether the Azure endpoint supports OpenAI json_schema response format.
# If unsure, keep false.
# AZURE_OPENAI_SUPPORTS_JSON_SCHEMA=false


# =============================
# Runtime / Pipeline Settings
# =============================

OUTPUT_DIR=output
LOG_LEVEL=INFO
MAX_RETRIES=3

# Validation mode:
# - warn   = log issues and continue
# - strict = raise on validation issues
VALIDATION_MODE=warn

# Prompt logging (can emit large logs)
LOG_PROMPTS=false

# Knowledge source ingestion cap (case builder)
KNOWLEDGE_SOURCE_MAX_CHARS=10000


# =============================
# Optional reproducibility knobs
# =============================

# Used by case-building random default selection paths
# CASE_RANDOM_SEED=42

## Quick Azure Foundry example
# DEFAULT_MODEL=azure-foundry/gpt-5.4-chat-latest
# AZURE_OPENAI_RESOURCE_NAME=my-foundry-resource
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_SUPPORTS_JSON_SCHEMA=false
